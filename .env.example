# Copie para .env.local e preencha. NUNCA envie o .env.local para o GitHub.

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao banco, usada por "npm run db:migrate" (Connect -> Session pooler)
SUPABASE_DB_URL=

# Chave de criptografia das senhas de canais e dos registros de login (32 bytes em base64)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHANNEL_SECRET_KEY=

# WhatsApp oficial (opcional)
WHATSAPP_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ES_CONFIG_ID=
# META_GRAPH_VERSION=v23.0
